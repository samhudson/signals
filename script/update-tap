#!/bin/bash
# script/update-tap vX.Y.Z [--print]: point the Homebrew formula at a release.
#
# Public repo: the tarball attached to the GitHub Release, with its SHA-256.
# Homebrew downloads that file on every install and upgrade, and GitHub counts
# each download (see script/downloads). Private repo: the git tag and commit,
# which needs repo access, and isn't counted.
#
# Pushes to the tap with $TAP_DEPLOY_KEY (an SSH deploy key with write access to
# the tap; CI), $TAP_TOKEN (a token; CI), or your own git login.
# --print shows the formula's source lines and changes nothing.
set -euo pipefail
cd "$(dirname "$0")/.."
NAME="signals"
REPO="${SIGNALS_REPO:-samhudson/$NAME}"
TAP="${SIGNALS_TAP:-samhudson/homebrew-tap}"
TAG="${1:?usage: script/update-tap vX.Y.Z [--print]}"
PRINT=0; [ "${2:-}" = "--print" ] && PRINT=1
[[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "only final releases go to the tap (got $TAG)"; exit 1; }
v="${TAG#v}"

visibility=$(GH_TOKEN="${GH_TOKEN:-${TAP_TOKEN:-}}" gh api "repos/$REPO" --jq .visibility 2>/dev/null || echo unknown)
if [ "$visibility" = public ]; then
  asset="https://github.com/$REPO/releases/download/$TAG/$NAME-$v.tar.gz"
  # The release publishes the checksum next to the tarball.
  sha=$(curl -fsSL "$asset.sha256" | awk '{print $1}')
  [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || { echo "no checksum for $asset (is the release published?)"; exit 1; }
  source=$(printf '  url "%s"\n  sha256 "%s"' "$asset" "$sha")
else
  rev=$(git rev-parse "$TAG^{commit}")
  source=$(printf '  url "https://github.com/%s.git",\n      tag:      "%s",\n      revision: "%s"' "$REPO" "$TAG" "$rev")
fi
if [ $PRINT = 1 ]; then echo "$source"; exit 0; fi

work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
if [ -n "${TAP_DEPLOY_KEY:-}" ]; then
  printf '%s\n' "$TAP_DEPLOY_KEY" > "$work/key"; chmod 600 "$work/key"
  export GIT_SSH_COMMAND="ssh -i $work/key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
  url="git@github.com:$TAP.git"
elif [ -n "${TAP_TOKEN:-}" ]; then url="https://x-access-token:$TAP_TOKEN@github.com/$TAP.git"
elif [ -n "${CI:-}" ]; then echo "::warning::No TAP_DEPLOY_KEY or TAP_TOKEN, so the Homebrew tap was not updated. See RELEASING.md."; exit 0
else url="https://github.com/$TAP.git"; fi

[ -n "${SIGNALS_TAP_URL:-}" ] && url="$SIGNALS_TAP_URL"   # tests: a local tap
git clone -q --depth 1 "$url" "$work/tap"
formula="$work/tap/Formula/$NAME.rb"
# Replace everything from the url line up to (not including) the license line.
SOURCE="$source" perl -0pi -e 's/^  url .*?(?=^  license )/$ENV{SOURCE}\n/ms' "$formula"
grep -q "$TAG\|$v.tar.gz" "$formula" || { echo "formula update failed"; exit 1; }

cd "$work/tap"
if git diff --quiet; then echo "tap already at $TAG"; exit 0; fi
git -c user.name="${GIT_AUTHOR_NAME:-$(git config user.name || echo github-actions)}" \
    -c user.email="${GIT_AUTHOR_EMAIL:-$(git config user.email || echo github-actions@users.noreply.github.com)}" \
    commit -qam "$NAME $v"
git push -q origin HEAD:main
echo "tap updated: $NAME $v ($visibility source)"
