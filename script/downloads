#!/bin/bash
# script/downloads [--json]: how many times Signals has been downloaded.
#
# Every `brew install` and `brew upgrade` downloads the tarball attached to a
# GitHub Release, and GitHub counts each request for it. Homebrew checks the
# file's headers before downloading it, and GitHub counts that check too, so
# one install shows up as about 2; "installs" is the count halved. Repo views and clones (last 14 days, as GitHub keeps them)
# are shown too when your login can see them.
#   script/downloads           a table per release, with totals
#   script/downloads --json    the same, for the weekly snapshot (.github/workflows/stats.yml)
set -euo pipefail
REPO="${SIGNALS_REPO:-samhudson/signals}"

releases=$(gh api "repos/$REPO/releases?per_page=100" --paginate 2>/dev/null) || { echo "Couldn't read releases for $REPO (is gh logged in?)" >&2; exit 1; }
# Views and clones need push access to the repo; otherwise GitHub refuses, and they're skipped.
traffic() { local t; if t=$(gh api "repos/$REPO/traffic/$1" 2>/dev/null) && jq -e '.count' >/dev/null 2>&1 <<<"$t"; then echo "$t"; else echo null; fi; }
views=$(traffic views); clones=$(traffic clones)

report=$(jq -sc --argjson views "$views" --argjson clones "$clones" --arg repo "$REPO" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
  (add // []) as $r
  | { repo: $repo, at: $at,
      releases: [ $r[] | {tag: .tag_name, published: .published_at, prerelease: .prerelease,
                          downloads: ([.assets[] | select(.name | endswith(".tar.gz")) | .download_count] | add // 0),
                          other: ([.assets[] | select(.name | (endswith(".tar.gz") or endswith(".sha256")) | not) | .download_count] | add // 0)} ],
      views_14d: ($views | if . then {count, uniques} else null end),
      clones_14d: ($clones | if . then {count, uniques} else null end) }
  | .releases |= map(. + {installs: (.downloads / 2 | ceil)})
  | . + {total_downloads: ([.releases[] | select(.prerelease | not) | .downloads] | add // 0)}
  | . + {total_installs: (.total_downloads / 2 | ceil)}' <<<"$releases")

if [ "${1:-}" = "--json" ]; then echo "$report"; exit 0; fi
jq -r '"Signals downloads (\(.repo))", ""' <<<"$report"
jq -r '(["release", "downloads", "≈ installs", "other files"] | @tsv),
       (.releases[] | [.tag + (if .prerelease then " (rc)" else "" end), .downloads, .installs, .other] | @tsv)' <<<"$report" | column -t -s $'\t'
jq -r '"",
  "Total (final releases): \(.total_downloads) downloads, about \(.total_installs) installs",
  (if .views_14d then "Repo views, last 14 days: \(.views_14d.count) (\(.views_14d.uniques) people)" else empty end),
  (if .clones_14d then "Repo clones, last 14 days: \(.clones_14d.count) (\(.clones_14d.uniques) people)" else empty end),
  "",
  "GitHub counts Homebrew checking the file as well as downloading it, so one install",
  "shows as about 2 downloads. The release check in CI installs once per final release."' <<<"$report"
